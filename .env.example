# =============================================================================
# .env.example — variáveis de ambiente (copie para .env e ajuste).
# Apenas SEGREDOS/infra ficam aqui; parâmetros do projeto vão em configs/*.yaml.
# O .env NUNCA deve ser commitado.
# =============================================================================

# Endereço do servidor Ollama local (sobrescreve configs/llm.yaml se definido).
# OLLAMA_HOST=http://127.0.0.1:11434

# Tracking do MLflow (padrão: ./mlruns local).
# MLFLOW_TRACKING_URI=./mlruns

# Sobrescreve a semente global (opcional).
# RANDOM_SEED=42
