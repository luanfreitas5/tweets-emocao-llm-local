# =============================================================================
# .env.example — variáveis de ambiente (copie para .env e ajuste).
# Apenas SEGREDOS/infra ficam aqui; parâmetros do projeto vão em configs/*.yaml.
# O .env NUNCA deve ser commitado (detect-secrets protege o repositório).
# =============================================================================

# Endereço do servidor Ollama local (sobrescreve `host` de configs/llm.yaml).
# OLLAMA_HOST=http://127.0.0.1:11434

# Tracking do MLflow: sempre um banco, nunca o file store ./mlruns.
# Sobrescreve `experiment.tracking_uri` de configs/config.yaml.
# MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db

# Sobrescreve a semente global (opcional).
# RANDOM_SEED=42

# --- docker-compose ---------------------------------------------------------
# Tag fixa da imagem do Ollama (obrigatória no compose; nunca `latest`).
# OLLAMA_VERSION=
# Versão da imagem da API e SHA do commit exibido em /version (make docker-build define o SHA).
# API_VERSION=dev
# GIT_SHA=
